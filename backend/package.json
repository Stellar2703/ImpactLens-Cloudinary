{
  "name": "impactlens-backend",
  "version": "1.0.0",
  "description": "ImpactLens AI Media Intelligence Backend - Node.js + Express + TypeScript + Prisma",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node src/prisma/seed.ts",
    "seed": "ts-node src/prisma/seed.ts",
    "test:cloudinary": "ts-node scripts/test-cloudinary.ts",
    "test:ai": "ts-node scripts/test-ai.ts",
    "test:nemotron": "ts-node scripts/run-nvidia-nemotron.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cloudinary": "^2.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^7.25.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.5",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
